# syntax=docker/dockerfile:1
# Development image for the whole OwneX monorepo (contracts + both Next.js apps).
# One image, reused by every service in docker-compose.yml.

FROM node:22-bookworm-slim

# git is needed by some npm deps; curl is used by the healthcheck/wait loops.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 \
    CI=true

# Source is bind-mounted by compose; node_modules live in named volumes.
CMD ["bash"]
