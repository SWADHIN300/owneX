# ─────────────────────────────────────────────────────────────
# OwneX — environment template
# Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ── Chain (Phase 7 — Sepolia deploy) ────────────────────────
# Public endpoint works but is rate limited; an Alchemy/Infura key is steadier.
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Private key of a THROWAWAY wallet that holds ONLY free faucet test ETH.
# Never use a wallet that holds real funds.
DEPLOYER_PRIVATE_KEY=

# Optional: for `hardhat verify` on Sepolia Etherscan
ETHERSCAN_API_KEY=

# ── Demo wallets (seed script) ──────────────────────────────
# The platform owner / first org admin. Defaults to the project wallet.
PLATFORM_ADMIN_ADDRESS=0x69FD94d7e3F931F80B658872B70dF5CCa4263888

# ── Deployed contract addresses (filled after deploy) ───────
IDENTITY_REGISTRY_ADDRESS=
ORG_ACCESS_MANAGER_ADDRESS=
ASSET_NFT_ADDRESS=

# ── Supabase (Phase 3) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth (Phase 3) ──────────────────────────────────────────
# 32+ char random string for iron-session cookie encryption.
SESSION_PASSWORD=
# Must match the domain in the SIWE message.
NEXT_PUBLIC_APP_DOMAIN=localhost:3000
# AES key for encrypting PII before it is stored in Supabase.
PII_ENCRYPTION_KEY=

# ── Metadata (Phase 2 upgrade — optional IPFS) ──────────────
PINATA_JWT=

# ── Misc ────────────────────────────────────────────────────
REPORT_GAS=false
