# OwneX Employee Portal — the worked "Sign in with OwneX" integration.
# Copy to .env.local and fill in. Do not commit real values.

# ── Sign in with OwneX ──────────────────────────────────────
# Origin of the owneX platform, without a trailing slash.
OWNEX_ORIGIN=http://localhost:3000

# From the owneX Applications screen, after an organization admin registers this
# application. The client id is public; the secret is shown exactly once.
OWNEX_CLIENT_ID=
# SERVER ONLY. Never put this in NEXT_PUBLIC_ anything, and never in frontend
# JavaScript — anyone who can read it can redeem authorization codes as this app.
# Lost it? Use "Rotate secret" on the Applications screen.
OWNEX_CLIENT_SECRET=

# The organization this portal signs users in to.
OWNEX_ORG_ID=1

# This portal's exact callback URL. It must match, character for character, one of
# the callback URLs registered for this application on owneX.
OWNEX_REDIRECT_URI=http://localhost:3001/callback

# The application slug used when asking owneX to revalidate access.
OWNEX_APP_SLUG=employee-portal

# ── This portal's own session ───────────────────────────────
# 32+ high-entropy characters. There is no default; the portal refuses to start a
# session without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PORTAL_SESSION_PASSWORD=
