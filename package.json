{
  "name": "ownex-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "OwneX — on-chain identity, organization access control, and NFT-backed asset ownership",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "clean": "hardhat clean",

    "node": "hardhat node",
    "dev:chain": "hardhat node",
    "dev:platform": "npm --prefix apps/platform run dev",

    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "seed:local": "hardhat run scripts/seed-demo.ts --network localhost",
    "preflight:sepolia": "hardhat run scripts/preflight-sepolia.ts --network sepolia",
    "deploy:sepolia": "npm run preflight:sepolia && hardhat run scripts/deploy.ts --network sepolia",
    "seed:sepolia": "hardhat run scripts/seed-demo.ts --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify-sepolia.ts --network sepolia",
    "config:platform:sepolia": "node scripts/configure-platform-sepolia.mjs",
    "export:abi": "hardhat run scripts/export-abi.ts",

    "seed:offchain": "npm --prefix apps/platform run seed:offchain",
    "seed:all": "npm run deploy:local && npm run seed:local && npm run export:abi && npm run seed:offchain",

    "verify:api": "node apps/platform/scripts/verify-api.mjs",
    "verify:all": "npm test && npm run verify:api",

    "setup": "npm install && npm --prefix apps/platform install && npm run compile && npm run export:abi",
    "typecheck": "npm --prefix apps/platform run typecheck"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.7",
    "hardhat": "^2.22.17",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  }
}
