{
  "compilerOptions": {
    "target": "ES2022",
    // node16 replaces the deprecated node10 resolution. Because this package has
    // no "type": "module", TypeScript still emits CommonJS, which is what
    // Hardhat and ts-node expect — so nothing about how scripts run changes.
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": ["./scripts", "./test", "./typechain-types", "./hardhat.config.ts"]
}
