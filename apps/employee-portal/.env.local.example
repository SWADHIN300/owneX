# OwneX Employee Portal — copy to .env.local and fill in.
# Do not commit real values.

# Exact deployed Platform origin, without a trailing slash.
PLATFORM_ORIGIN=http://localhost:3000
# This Portal's exact callback URL. It must match Platform's PORTAL_CALLBACK_URL.
PORTAL_CALLBACK_URL=http://localhost:3001/callback
# Must match Platform's PORTAL_CLIENT_SECRET. Keep server-only.
PORTAL_CLIENT_SECRET=
# 32+ high-entropy characters, used to encrypt this portal's session cookie.
PORTAL_SESSION_PASSWORD=
# Northwind's seeded organization.
PORTAL_ORG_ID=1
